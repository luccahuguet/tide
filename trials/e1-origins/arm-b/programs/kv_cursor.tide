// Task 10, kv_cursor: src/lib.tide

/// A position in a source string. Text it returns is a slice of the source,
/// so it stays usable after the cursor is gone.
#[derive(Debug, Clone)]
pub struct Cursor<'a> {
    src: &'a str,
    pos: usize,
}

impl<'a> Cursor<'a> {
    pub fn new(src: &'a str) -> Self {
        Cursor { src, pos: 0 }
    }

    /// The next character, without consuming it.
    pub fn peek(&self) -> Option<char> {
        self.src[self.pos..].chars().next()
    }

    /// Consumes and returns the next character.
    pub fn bump(&mut self) -> Option<char> {
        let c = self.peek()?;
        self.pos += c.len_utf8();
        Some(c)
    }

    pub fn at_end(&self) -> bool {
        self.pos == self.src.len()
    }

    /// Byte offset of the next character in the source.
    pub fn offset(&self) -> usize {
        self.pos
    }

    /// Skips spaces, tabs, and carriage returns. Newlines are not skipped,
    /// because they separate pairs.
    pub fn skip_ws(&mut self) {
        self.eat_while(|c| matches!(c, ' ' | '\t' | '\r'));
    }

    /// Consumes characters while `pred` holds and returns them as a slice of
    /// the source.
    pub fn eat_while(&mut self, mut pred: impl FnMut(char) -> bool) -> &'a str {
        let src = self.src;
        let start = self.pos;
        while let Some(c) = self.peek() {
            if !pred(c) {
                break;
            }
            self.pos += c.len_utf8();
        }
        &src[start..self.pos]
    }
}

/// What `parse_pairs` found wrong.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ParseErrorKind {
    /// An `=` with no key before it.
    EmptyKey,
    /// A key not followed by `=`.
    MissingEquals,
    /// A `"` with no closing `"`.
    UnterminatedQuote,
    /// Text after a closing quote, before the next separator.
    ExpectedSeparator,
}

/// A `parse_pairs` failure at byte `offset` of the source.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Error)]
#[error("{kind:?} at byte {offset}")]
pub struct ParseError {
    pub offset: usize,
    pub kind: ParseErrorKind,
}

/// Parses `key=value` pairs separated by `;` or newlines, with optional
/// spaces around keys, values, and separators, and appends them to `out` as
/// slices of `src`. A value may be double-quoted: it is returned without the
/// quotes, and has no escapes. Returns the number of pairs appended. On an
/// error, `out` is left as it was.
pub fn parse_pairs<'a>(src: &'a str, out: &mut Vec<(&'a str, &'a str)>) -> Result<usize, ParseError> {
    let before = out.len();
    match parse_into(&mut Cursor::new(src), out) {
        Ok(()) => Ok(out.len() - before),
        Err(e) => {
            out.truncate(before);
            Err(e)
        }
    }
}

fn parse_into<'a>(cur: &mut Cursor<'a>, out: &mut Vec<(&'a str, &'a str)>) -> Result<(), ParseError> {
    loop {
        cur.skip_ws();
        match cur.peek() {
            None => return Ok(()),
            Some(';' | '\n') => {
                cur.bump();
                continue;
            }
            Some(_) => {}
        }
        let key_at = cur.offset();
        let key = cur.eat_while(|c| !matches!(c, '=' | ';' | '\n')).trim_end();
        if key.is_empty() {
            return Err(ParseError { offset: key_at, kind: ParseErrorKind::EmptyKey });
        }
        if cur.peek() != Some('=') {
            return Err(ParseError { offset: cur.offset(), kind: ParseErrorKind::MissingEquals });
        }
        cur.bump();
        cur.skip_ws();
        let value = if cur.peek() == Some('"') {
            let quote_at = cur.offset();
            cur.bump();
            let quoted = cur.eat_while(|c| c != '"');
            if cur.bump().is_none() {
                return Err(ParseError { offset: quote_at, kind: ParseErrorKind::UnterminatedQuote });
            }
            cur.skip_ws();
            if !matches!(cur.peek(), None | Some(';' | '\n')) {
                return Err(ParseError { offset: cur.offset(), kind: ParseErrorKind::ExpectedSeparator });
            }
            quoted
        } else {
            cur.eat_while(|c| c != ';' && c != '\n').trim_end()
        };
        out.push((key, value));
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn appends_to_pairs_from_another_string() {
        let earlier = String::from("origin = elsewhere");
        let src = String::from(" name = tide ;\nquote = \"a; b\"\n\nempty=;last=1\r\n");
        let mut pairs: Vec<(&str, &str)> = Vec::new();
        assert_eq!(parse_pairs(&earlier, &mut pairs), Ok(1));
        assert_eq!(parse_pairs(&src, &mut pairs), Ok(4));
        assert_eq!(
            pairs,
            [("origin", "elsewhere"), ("name", "tide"), ("quote", "a; b"), ("empty", ""), ("last", "1")]
        );
    }

    #[test]
    fn each_error_kind_with_its_offset() {
        const CASES: [(&str, usize, ParseErrorKind); 5] = [
            ("a=1; =2", 5, ParseErrorKind::EmptyKey),
            ("a=1\nflag\n", 8, ParseErrorKind::MissingEquals),
            ("abc", 3, ParseErrorKind::MissingEquals),
            ("k = \"open", 4, ParseErrorKind::UnterminatedQuote),
            ("k=\"v\" x", 6, ParseErrorKind::ExpectedSeparator),
        ];
        for (src, offset, kind) in CASES {
            let mut pairs = vec![("kept", "untouched")];
            assert_eq!(parse_pairs(src, &mut pairs), Err(ParseError { offset, kind }), "input {src:?}");
            assert_eq!(pairs, [("kept", "untouched")], "input {src:?}");
        }
    }

    #[test]
    fn eaten_text_outlives_the_cursor() {
        let src = String::from("hello world");
        let word = {
            let mut cur = Cursor::new(&src);
            cur.eat_while(|c| c.is_alphabetic())
        };
        assert_eq!(word, "hello");
    }

    #[test]
    fn cursor_basics() {
        let mut cur = Cursor::new(" \té=1");
        cur.skip_ws();
        assert_eq!(cur.offset(), 2);
        assert_eq!(cur.peek(), Some('é'));
        assert_eq!(cur.bump(), Some('é'));
        assert_eq!(cur.offset(), 4);
        assert!(!cur.at_end());
        assert_eq!(cur.eat_while(|c| c != '1'), "=");
        assert_eq!(cur.bump(), Some('1'));
        assert!(cur.at_end());
        assert_eq!(cur.bump(), None);
        assert_eq!(cur.peek(), None);
    }
}

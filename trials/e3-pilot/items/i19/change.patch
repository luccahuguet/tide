+            .map_err(ExportError::Io)?;
+        if let Err(e) = file.write_all(body.as_bytes()).and_then(|()| fs.rename(&part, &path)) {
+            let _ = fs.remove_file(&part);
+            return Err(ExportError::Io(e));
+        }
     }
     Ok(reports.len())
